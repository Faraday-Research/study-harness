# Copy to .env and fill in. `npm run dev` loads .env automatically.
# Command-line flags override these: -m <provider:model>, --max-turns <n>, --skills <a,b>

# --- Secrets (never commit real values) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Web search (Tavily). The harness reads this from its own .env (or the environment,
# which wins), so apps using the harness never pass it in or load this file.
# Free key at tavily.com.
TAVILY_API_KEY=

# --- Harness settings ---
# Provider and model, as "provider:model" or just "provider" for its default.
HARNESS_MODEL=openai:gpt-5
# Max model calls per message before the engine stops (whole number >= 1).
HARNESS_MAX_TURNS=20
# Comma-separated built-in skills to enable (default: all).
# None are enabled yet: topic-research exists but isn't wired into the harness.
# HARNESS_SKILLS=topic-research
